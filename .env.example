# Токен от @BotFather
BOT_TOKEN=123456:AA...

# Белый список Telegram user id через запятую. Пусто = бот отвечает всем (не надо так).
# Свой id: напиши боту @userinfobot
ALLOWED_USER_IDS=111111111

# --- Лимиты ---
# Официальный Bot API даёт боту максимум 50 МБ на отправку файла.
# Держим запас. Больше — только через локальный Bot API server (см. README).
MAX_FILESIZE_MB=48
MAX_DURATION_SEC=10800
MAX_HEIGHT=1080
MAX_CONCURRENT_DOWNLOADS=2

# --- Опционально ---
# Локальный Bot API server поднимает лимит до 2000 МБ:
# TG_API_BASE=http://localhost:8081
# Прокси для yt-dlp, если YouTube начал требовать «подтвердите, что вы не робот»:
# PROXY=socks5://user:pass@host:1080
# Прокси для самого Bot API — нужен, если с сервера не открывается
# соединение до api.telegram.org (по умолчанию берётся PROXY):
# TG_PROXY=socks5://user:pass@host:1080
DOWNLOAD_DIR=./downloads
COOKIES_DIR=./cookies
